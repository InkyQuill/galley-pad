{
  "name": "galley-pad",
  "version": "1.7.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint --max-warnings 0 src tests vite.config.ts playwright.config.ts",
    "commitlint": "node scripts/check-conventional-commit.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "preview": "vite preview",
    "test": "bun run test:unit && bun run test:scripts",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:integration": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "verify:fast": "node scripts/verify-fast.mjs",
    "verify": "node scripts/verify.mjs",
    "macos:pkg": "node scripts/build-macos-pkg.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@inkyquill/galley-editor": "0.18.0",
    "@inkyquill/galley-themes": "0.18.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-opener": "~2.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^17",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "source-map-js": "^1.2.2",
    "undici": "^7.30.1"
  }
}
